# ── Secrets and personal config (never committed) ───────────────────────
.env
.env.*
!.env.example
kronos.yml
config/*
!config/.gitkeep
scripts/*
!scripts/*.example
# OAuth files, wherever they end up
**/token.json
**/credentials.json
**/client_secret*.json

# Patch zips kept locally (applied on the server, never committed)
/patch/
/patches/

