# ── Secrets and personal config (never committed) ───────────────────────
# .env may be a symlink to a shared homelab .env — ignored either way.
.env
.env.*
!.env.example
kronos.yml
kronos.yml.*
!kronos.yml.example
config/*
!config/.gitkeep
scripts/*
!scripts/*.example
# OAuth files, wherever they end up
**/token.json
**/credentials.json
**/client_secret*.json

# Patch zips and config backups kept locally (applied on the server, never committed)
/patch/
/patches/
*.bak
*.zip

# ── Build and test output ───────────────────────────────────────────────
/kronos
/bin/
/dist/
*.exe
*.test
*.out
*.log
coverage.*
go.work
go.work.sum

# ── Editor and OS clutter ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
