# Kronos — host settings. Copy to .env (gitignored) and fill in.
# Only docker compose reads this file (for the ${...} in docker-compose.yml). Inside the
# container Kronos sees only TZ and the KRONOS_* values that docker-compose.yml lists under
# environment: (kronos.yml uses them as ${KRONOS_…}). kronos.yml uses container paths only,
# so no host path, place, domain or secret is ever written in the repo.
# A value may build on one defined above it: NOTE_PATH=${DATA_PATH}/notes

# ── Host folders ─────────────────────────────────────────────────────────
# Base data folder (only used to build the paths below)
DATA_PATH=/srv/data

# Notes vault → mounted at /data/notes (kronos.yml paths: events, inbox, logs, outbox, watch …)
NOTE_PATH=${DATA_PATH}/notes

# Folder the health site (index.html) is written to → mounted at /data/health-site
# e.g. ${WEB_PATH}/health.${BASE_DOMAIN} when a shared .env already defines those
KRONOS_HEALTH_SITE=/srv/web/health

# Folder notes_backup writes <prefix>_YYYYMMDD_HHMMSS.tar.gz to → mounted at /data/backups.
# Outside NOTE_PATH, so backups are not synced to the phone or archived into themselves.
KRONOS_BACKUP=${DATA_PATH}/backups/notes

# ── Container user and clock ─────────────────────────────────────────────
# Owner of every file Kronos writes (run: id -u ; id -g). The folders above must be writable by it.
PUID=1000
PGID=1000

# Time zone for the cron schedules in kronos.yml and backup file names (IANA name, e.g. Asia/Kolkata)
TZ=UTC

# ── Personal job values (read by kronos.yml as ${KRONOS_…}) ──────────────
# Weather fallback when the phone's location.md is missing (empty = no fallback: skip until Kshan writes one)
KRONOS_WEATHER_LAT=
KRONOS_WEATHER_LON=
KRONOS_WEATHER_PLACE=
# City for the gold rate pages, as the sites spell it (e.g. mumbai, new-delhi)
KRONOS_GOLD_CITY=

# Secrets: none here. Google OAuth (calendar_sync) lives in ./config/token.json (gitignored).
