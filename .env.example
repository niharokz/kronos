# Copy to .env (gitignored) and set your own values.
# docker compose reads it for the ${...} values in docker-compose.yml; nothing here
# is passed into the container, and no host path is written anywhere in the repo.
# A value may build on an earlier one with ${NAME}.

# Base folder for your data on the host
DATA_PATH=/srv/data

# Notes vault (mounted at /data/notes → kronos.yml paths: events, inbox, archive, logs, outbox …)
NOTE_PATH=${DATA_PATH}/notes

# Web root the health site is published under (mounted at /docker/web → kronos.yml paths.health_site)
WEB_PATH=/srv/web

# Owner of every file Kronos writes (run: id -u ; id -g)
PUID=1000
PGID=1000

# Time zone for the cron schedules in kronos.yml (IANA name, e.g. Europe/Berlin)
TZ=UTC
